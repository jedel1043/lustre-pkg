# Exclusions for licenserecon (lrc).
#
# Files listed here are removed from the d/copyright vs licensecheck
# reconciliation entirely; every entry must have a rationale comment.
# Requires licenserecon >= 1.17 (the version in Ubuntu resolute, 11.0,
# is known-good); on older versions (e.g. noble's 1.7) this file is
# ignored and lrc reports these rows as differences.

# Documentation prose that merely *mentions* LGPL (for the DLC library);
# the file itself has no license and falls under the GPL-2 catch-all.
Documentation/dlc.txt

# Documentation about licensing rules; licensecheck reports the SPDX name
# "GPL-2.0-only" while d/copyright uses the DEP-5 short name "GPL-2".
Documentation/process/license-rules.rst

# licensecheck reports an unversioned "GPL"; the header says version 2.
# (licenserecon only handles this natively from 14.0 onwards.)
contrib/scripts/get_maintainer.pl

# cme helper file: YAML containing license short-names as data strings,
# not source code.
debian/fill.copyright.blanks.yml

# No SPDX tag; d/copyright lists BSD-3-clause or HPND-sell-variant or NTP
# based on manual analysis of the embedded license texts, licensecheck
# only detects HPND-sell-variant and/or NTP.
lustre/utils/gss/lgss_krb5_utils.c
