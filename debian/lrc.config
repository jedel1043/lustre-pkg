# Documentation with no SPDX tag; licenserecon detects LGPL from prose mention
Documentation/dlc.txt

# Autoconf m4 macros: SPDX is GPL-2.0-or-later / GPL-3.0-or-later, but
# licenserecon detects the Autoconf exception boilerplate text
config/ac_pkg_swig.m4
config/ac_python_devel.m4

# licenserecon says "GNU GPL" without version; file header says "version 2"
contrib/scripts/get_maintainer.pl

# lgss_krb5_utils.c has no SPDX tag; d/copyright lists 3 licenses based on
# manual analysis, licenserecon only detects 2
# lustre/utils/gss/lgss_krb5_utils.c

# "or" vs "and/or" syntax differences (SPDX OR vs licenserecon and/or)
contrib/scripts/lioprof/launcher.sh
contrib/scripts/lioprof/parser.sh
include/uapi/linux/lustre/ec_base.h
include/uapi/linux/lustre/erasure_code.h
include/uapi/linux/lustre/gf_vect_mul.h
lustre/ec/ec_kmod.c
lustre/utils/gss/gss_util.c
lustre/utils/gss/lgss_utils.c

# cme helper file (YAML data containing license names as strings, not source code)
debian/fill.copyright.blanks.yml

# SPDX is GPL-2.0; d/copyright uses GPL-2; licenserecon uses GPL-2.0-only
# (all three are the same license, just different naming precision)
Documentation/process/license-rules.rst
