From: =?utf-8?q?Jos=C3=A9_Juli=C3=A1n_Espina?= <julian.espina@canonical.com>
Date: Wed, 2 Sep 2026 17:55:08 -0600
Subject: Add compatibility patch for Linux 7.2

---
 config/lustre-core.m4                   | 69 +++++++++++++++++++++++++++++++++
 include/linux/libcfs/libcfs_private.h   |  1 +
 include/lustre_compat/linux/string.h    | 23 +++++++++++
 include/uapi/linux/lustre/lustre_user.h | 23 +++++++++++
 lustre/include/lustre_compat.h          |  1 +
 lustre/llite/xattr_security.c           | 40 +++++++++++++++++++
 lustre_compat/fs/crypto/keyring.c       |  4 +-
 7 files changed, 159 insertions(+), 2 deletions(-)

diff --git a/config/lustre-core.m4 b/config/lustre-core.m4
index 2ee736b..bdf97c5 100644
--- a/config/lustre-core.m4
+++ b/config/lustre-core.m4
@@ -2425,6 +2425,67 @@ AC_DEFUN([LC_HAVE_STRUCT_PAGEVEC], [
 	])
 ]) # LC_HAVE_STRUCT_PAGEVEC
 
+#
+# LC_HAVE_KERNEL_STRNCPY
+#
+# Linux v7.2 removed strncpy() from the kernel as part of the removal of
+# deprecated string functions. strscpy_pad() is the intended replacement,
+# but it does not provide strncpy()'s exact semantics (it fails on
+# truncation rather than silently clamping, though it also NUL-pads the
+# remainder of the destination buffer).
+# This test detects whether the kernel still declares strncpy(); if not,
+# a compatibility shim is provided by lustre_compat/linux/string.h and
+# include/uapi/linux/lustre/lustre_user.h.
+#
+AC_DEFUN([LC_SRC_HAVE_KERNEL_STRNCPY], [
+	LB2_LINUX_TEST_SRC([kernel_strncpy_declared], [
+		#include <linux/string.h>
+	],[
+		char buf[8];
+
+		strncpy(buf, "abc", sizeof(buf));
+	],[-Werror])
+])
+AC_DEFUN([LC_HAVE_KERNEL_STRNCPY], [
+	LB2_MSG_LINUX_TEST_RESULT([if 'strncpy()' is declared by the kernel],
+	[kernel_strncpy_declared], [
+		AC_DEFINE(HAVE_KERNEL_STRNCPY, 1,
+			[strncpy() is declared by the kernel])
+	])
+]) # LC_HAVE_KERNEL_STRNCPY
+
+#
+# LC_HAVE_SECURITY_LISTSECURITY_PTR
+#
+# Linux v7.2 changed the signature of security_inode_listsecurity() from
+# int security_inode_listsecurity(struct inode *inode, char *buffer,
+#                                 size_t buffer_size)
+# to
+# int security_inode_listsecurity(struct inode *inode, char **buffer,
+#                                 ssize_t *remaining_size)
+# The new interface advances *@buffer and decrements *@remaining_size as
+# xattr names are written, returns 0 on success / -errno on failure, and
+# accepts a NULL *@buffer to request the required size.
+#
+AC_DEFUN([LC_SRC_HAVE_SECURITY_LISTSECURITY_PTR], [
+	LB2_LINUX_TEST_SRC([security_listsecurity_double_ptr], [
+		#include <linux/security.h>
+	],[
+		int rc __attribute__ ((unused));
+
+		rc = security_inode_listsecurity((struct inode *)NULL,
+						 (char **)NULL,
+						 (ssize_t *)NULL);
+	],[-Werror])
+])
+AC_DEFUN([LC_HAVE_SECURITY_LISTSECURITY_PTR], [
+	LB2_MSG_LINUX_TEST_RESULT([if security_inode_listsecurity() takes a double pointer],
+	[security_listsecurity_double_ptr], [
+		AC_DEFINE(HAVE_SECURITY_LISTSECURITY_PTR, 1,
+			[security_inode_listsecurity() takes char ** and ssize_t *])
+	])
+]) # LC_HAVE_SECURITY_LISTSECURITY_PTR
+
 #
 # LC_HAVE_FLUSH___WORKQUEUE
 #
@@ -3973,6 +4034,10 @@ AC_DEFUN([LC_PROG_LINUX_SRC], [
 
 	# 7.1
 	LC_SRC_HAVE_DCACHE_ANON_UNION_D_ALIAS
+
+	# 7.2
+	LC_SRC_HAVE_KERNEL_STRNCPY
+	LC_SRC_HAVE_SECURITY_LISTSECURITY_PTR
 ])
 
 AC_DEFUN([LC_PROG_LINUX_RESULTS], [
@@ -4201,6 +4266,10 @@ AC_DEFUN([LC_PROG_LINUX_RESULTS], [
 
 	# 7.1
 	LC_HAVE_DCACHE_ANON_UNION_D_ALIAS
+
+	# 7.2
+	LC_HAVE_KERNEL_STRNCPY
+	LC_HAVE_SECURITY_LISTSECURITY_PTR
 ])
 
 #
