index 1634e90..e7287d9 100644
--- a/include/linux/libcfs/libcfs_private.h
+++ b/include/linux/libcfs/libcfs_private.h
@@ -22,6 +22,7 @@
 
 #include <linux/slab.h>
 #include <lustre_compat/linux/vmalloc.h>
+#include <lustre_compat/linux/string.h>
 
 #ifdef LIBCFS_DEBUG
 
diff --git a/include/lustre_compat/linux/string.h b/include/lustre_compat/linux/string.h
index 515dfe7..b078467 100644
--- a/include/lustre_compat/linux/string.h
+++ b/include/lustre_compat/linux/string.h
@@ -10,6 +10,29 @@
 #include <linux/string.h>
 #include <lustre_compat/linux/fortify-string.h>
 
+#if !defined(HAVE_KERNEL_STRNCPY) && !defined(__LUSTRE_COMPAT_STRNCPY_SHIM)
+/*
+ * Linux v7.2 removed strncpy() from the kernel. Provide an inline
+ * replacement with the exact semantics of the removed function: copy at
+ * most n bytes of src into dest, NUL-padding the remainder of dest when
+ * src is shorter than n. The NUL padding is significant: several Lustre
+ * structures (e.g. struct obd_uuid) rely on the destination buffer being
+ * fully initialized for whole-buffer comparisons.
+ */
+#define __LUSTRE_COMPAT_STRNCPY_SHIM
+static inline char *strncpy(char *dest, const char *src, size_t n)
+{
+	size_t i;
+
+	for (i = 0; i < n && src[i] != '\0'; i++)
+		dest[i] = src[i];
+	for (; i < n; i++)
+		dest[i] = '\0';
+
+	return dest;
+}
+#endif /* !HAVE_KERNEL_STRNCPY */
+
 #ifndef memset_startat
 /** from linux 5.19 include/linux/string.h: */
 #define memset_startat(obj, v, member)					\
diff --git a/include/uapi/linux/lustre/lustre_user.h b/include/uapi/linux/lustre/lustre_user.h
index 1290b37..1fa879d 100644
--- a/include/uapi/linux/lustre/lustre_user.h
+++ b/include/uapi/linux/lustre/lustre_user.h
@@ -1459,6 +1459,29 @@ struct obd_uuid {
 	char uuid[UUID_MAX];
 };
 
+#if defined(__KERNEL__) && !defined(HAVE_KERNEL_STRNCPY) && \
+	!defined(__LUSTRE_COMPAT_STRNCPY_SHIM)
+/*
+ * Linux v7.2 removed strncpy() from the kernel. Provide an inline
+ * replacement with the exact semantics of the removed function (see
+ * lustre_compat/linux/string.h). This header is included before the
+ * lustre_compat.h umbrella in some compilation units, so the shim is
+ * duplicated here behind a shared guard.
+ */
+#define __LUSTRE_COMPAT_STRNCPY_SHIM
+static inline char *strncpy(char *dest, const char *src, size_t n)
+{
+	size_t i;
+
+	for (i = 0; i < n && src[i] != '\0'; i++)
+		dest[i] = src[i];
+	for (; i < n; i++)
+		dest[i] = '\0';
+
+	return dest;
+}
+#endif /* __KERNEL__ && !HAVE_KERNEL_STRNCPY */
+
 static inline bool obd_uuid_equals(const struct obd_uuid *u1,
 				   const struct obd_uuid *u2)
 {
diff --git a/lustre/include/lustre_compat.h b/lustre/include/lustre_compat.h
index 1d76303..d07dd24 100644
--- a/lustre/include/lustre_compat.h
+++ b/lustre/include/lustre_compat.h
@@ -28,6 +28,7 @@
 #include <linux/security.h>
 #include <lustre_compat/linux/folio_batch.h>
 #include <linux/workqueue.h>
+#include <lustre_compat/linux/string.h>
 #include <lustre_compat/linux/shrinker.h>
 #include <lustre_compat/linux/xarray.h>
 #include <lustre_compat/linux/folio.h>
diff --git a/lustre/llite/xattr_security.c b/lustre/llite/xattr_security.c
index eda23b6..34aca60 100644
--- a/lustre/llite/xattr_security.c
+++ b/lustre/llite/xattr_security.c
@@ -242,6 +242,45 @@ int ll_secctx_name_store(struct inode *in)
 	if (!ll_security_xattr_wanted(in))
 		return 0;
 
+#ifdef HAVE_SECURITY_LISTSECURITY_PTR
+	/*
+	 * Linux v7.2 interface: security_inode_listsecurity() writes the
+	 * xattr names into *@buffer, advancing it and decrementing
+	 * *@remaining_size.  A NULL *@buffer requests the required size.
+	 * It returns 0 on success, or -errno on failure.
+	 */
+	{
+		ssize_t size = 0;
+		char *buffer;
+
+		/* get size of xattr name */
+		rc = security_inode_listsecurity(in, NULL, &size);
+		if (rc < 0 || size <= 0)
+			/* rc is 0 whenever the call succeeds, so this returns
+			 * the error, or 0 for "no security context" */
+			return rc;
+
+		if (sbi->ll_secctx_name)
+			ll_secctx_name_free(sbi);
+
+		OBD_ALLOC(sbi->ll_secctx_name, size + 1);
+		if (!sbi->ll_secctx_name)
+			return -ENOMEM;
+
+		/* save the xattr name */
+		buffer = sbi->ll_secctx_name;
+		rc = security_inode_listsecurity(in, &buffer, &size);
+		if (rc < 0)
+			goto err_free;
+
+		/* size = number of bytes written */
+		size = buffer - sbi->ll_secctx_name;
+		if (size == 0)
+			goto err_free; /* nothing written: no ctx, not an error */
+		sbi->ll_secctx_name_size = size;
+		rc = size;
+	}
+#else
 	/* get size of xattr name */
 	rc = security_inode_listsecurity(in, NULL, 0);
 	if (rc <= 0)
@@ -265,6 +304,7 @@ int ll_secctx_name_store(struct inode *in)
 		rc = -ERANGE;
 		goto err_free;
 	}
+#endif
 
 	/* sanity check */
 	sbi->ll_secctx_name[rc] = '\0';
